{
  // Account (and optional custom domain) are chosen at deploy time by ../admin.sh.
  "name": "r2share",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "share" }]
  // secret: MASTER_KEY (set by ../admin.sh)
}
